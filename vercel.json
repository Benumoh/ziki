{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/v1/webhooks/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/cron",
      "schedule": "* * * * *"
    }
  ]
}
